<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Robot</AssemblyName>
		<ApplicationVisualStyles>true</ApplicationVisualStyles>
		<ApplicationUseCompatibleTextRendering>true</ApplicationUseCompatibleTextRendering>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="wwwroot\**\*" />
		<EmbeddedResource Update="wwwroot\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<!-- 合并单项目: 嵌入 WebView 的 .resx, 逻辑名须与 Resources.Designer.cs 的 ResourceManager("Robot.Properties.Resources") 一致 -->
	</ItemGroup>

	<!-- 合并单项目: 直接编译 WebView 源码(原 WebView.csproj 已删除); 排除 obj/bin 残留 -->
	<ItemGroup>
		<Compile Include="..\WebView\**\*.cs" Exclude="..\WebView\obj\**\*.cs;..\WebView\bin\**\*.cs" Link="WebView\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
	  <AdditionalFiles Remove="app.manifest" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Forms\RobotForm.Events.cs" />
	  <Compile Remove="Forms\RobotForm.IDisplayHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IDownloadHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IDragHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IFocusHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IKeyboardHandler.cs" />
	  <Compile Remove="Forms\RobotForm.ILifeSpanHandler.cs" />
	  <Compile Remove="Forms\RobotForm.ILoadHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IRenderHandler.cs" />
	  <Compile Remove="Forms\RobotForm.IRenderHandler.Implements.cs" />
	  <Compile Remove="Forms\RobotForm.IRequestHandler.cs" />
	  <Compile Remove="Forms\RobotForm.Members.cs" />
	  <Compile Remove="Forms\RobotForm.Overrides.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.5" />
		<PackageReference Include="SharpGen.Runtime" Version="2.0.0-beta.13" />
		<PackageReference Include="SharpGen.Runtime.COM" Version="2.0.0-beta.13" />
		<PackageReference Include="SkiaSharp" Version="3.119.0" />
		<PackageReference Include="Vanara.PInvoke.SHCore" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.Gdi32" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.DwmApi" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.UxTheme" Version="4.1.3" />
		<PackageReference Include="Vortice.Direct2D1" Version="2.4.2" />
		<PackageReference Include="Vortice.Direct3D11" Version="2.4.2" />
		<PackageReference Include="Vortice.DirectComposition" Version="2.4.2" />
		<PackageReference Include="Vortice.DXGI" Version="2.4.2" />
		<PackageReference Include="Vortice.Mathematics" Version="1.4.26" />
	</ItemGroup>

</Project>
